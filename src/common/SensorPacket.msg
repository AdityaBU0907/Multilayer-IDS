// SensorPacket.msg
// Compiled with: opp_msgc SensorPacket.msg
// This generates SensorPacket_m.h and SensorPacket_m.cc

cplusplus {{
#include <string>
}}

// Raw telemetry packet generated by Mist (IoT) nodes
// Feature names map directly to NSL-KDD dataset columns
message SensorPacket
{
    // --- Identification ---
    int    nodeId;                  // Originating mist node ID
    int    sessionId;               // Flow/connection session ID
    double creationTime;            // simTime() at mist node (for latency calc)

    // --- NSL-KDD Core Features (subset used per layer) ---
    // Mist uses features 0-9 (lightweight)
    // Edge uses features 0-19
    // Fog/Cloud uses all 41

    double duration;                // Length of connection (seconds)
    string protocolType;            // tcp, udp, icmp
    string service;                 // http, ftp, smtp, etc.
    string flag;                    // Connection state: SF, S0, REJ, etc.
    double srcBytes;                // Bytes from src to dst
    double dstBytes;                // Bytes from dst to src
    int    land;                    // 1 if src/dst host+port are same
    int    wrongFragment;           // Number of wrong fragments
    int    urgent;                  // Number of urgent packets
    double interArrivalTime;        // Time between successive packets (derived)
    double payloadSize;             // Current packet payload in bytes

    // Derived statistical features (computed at mist)
    double meanPayload;             // Rolling mean payload (window=100)
    double stddevPayload;           // Rolling stddev payload
    double meanIAT;                 // Rolling mean inter-arrival time
    double stddevIAT;               // Rolling stddev inter-arrival time
    double byteRate;                // bytes/sec in last window

    // NSL-KDD traffic features (set by traffic generator)
    int    count;                   // Connections to same host last 2 sec
    int    srvCount;                // Connections to same service last 2 sec
    double serrorRate;              // % connections with SYN errors
    double srvSerrorRate;
    double rerrorRate;
    double srvRerrorRate;
    double sameSrvRate;
    double diffSrvRate;
    double srvDiffHostRate;
    double dstHostCount;
    double dstHostSrvCount;
    double dstHostSameSrvRate;
    double dstHostDiffSrvRate;
    double dstHostSameSrcPortRate;
    double dstHostSrvDiffHostRate;
    double dstHostSerrorRate;
    double dstHostSrvSerrorRate;
    double dstHostRerrorRate;
    double dstHostSrvRerrorRate;
    int    numFailedLogins;
    int    loggedIn;
    int    numCompromised;
    int    rootShell;
    int    suAttempted;
    int    numRoot;
    int    numFileCreations;
    int    numShells;
    int    numAccessFiles;
    int    numOutboundCmds;
    int    isHostLogin;
    int    isGuestLogin;

    // --- Ground Truth (for evaluation only, not used by IDS logic) ---
    bool   isAttack;                // True if this packet belongs to an attack flow
    int    attackType;              // 0=normal,1=DoS,2=Probe,3=R2L,4=U2R
    string attackLabel;             // e.g., "neptune", "portsweep", "normal"

    // --- IDS Flags (set as packet traverses layers) ---
    bool   mistAlertFlag;           // Mist flagged this packet
    bool   edgeAlertFlag;           // Edge classified as attack
    bool   skipDetection;           // Set when mist offloads upward (Contribution 1)
    double mistDetectionTime;       // simTime() when mist detected anomaly
    double edgeDetectionTime;       // simTime() when edge detected
    int    edgePredictedClass;      // Edge ML classification result
}
