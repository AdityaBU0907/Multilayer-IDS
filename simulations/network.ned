// network.ned
// ═══════════════════════════════════════════════════════════════════════
// Complete Multi-Layer IDS Network Topology
//
//  20 MistNodes  → 4 EdgeGateways → 2 FogNodes → 1 CloudServer
//   (5 per edge)     (2 per fog)
//
// Channel parameters match realistic link budgets:
//   Mist→Edge  : 1 Mbps,  1 ms   (Wi-Fi / Zigbee / BLE)
//   Edge→Fog   : 100 Mbps, 5 ms  (LAN / Fiber)
//   Fog→Cloud  : 1 Gbps,  20 ms  (WAN / backbone)
// ═══════════════════════════════════════════════════════════════════════

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

network MultiLayerIDSNetwork
{
    parameters:
        // ── Experiment toggles (overridden in omnetpp.ini per config) ──
        bool   idsEnabled          = default(true);
        bool   adaptiveOffload     = default(false);
        bool   latencyAwareRouting = default(false);
        bool   enableDistillation  = default(false);
        double attackRatio         = default(0.20);
        string detectionMode       = default("hybrid");
        bool   useTrace            = default(true);

        @display("bgb=900,600");

    types:
        // Mist → Edge channel  (low bandwidth, low latency)
        channel MistToEdgeChan extends ned.DatarateChannel {
            datarate  = 1Mbps;
            delay     = 1ms;
            per       = 0.001;    // 0.1% packet error rate
        }
        // Edge → Fog channel
        channel EdgeToFogChan extends ned.DatarateChannel {
            datarate  = 100Mbps;
            delay     = 5ms;
            per       = 0.0001;
        }
        // Fog → Cloud channel
        channel FogToCloudChan extends ned.DatarateChannel {
            datarate  = 1Gbps;
            delay     = 20ms;
            per       = 0.00001;
        }

    submodules:
        // ── Mist layer: 20 IoT sensor nodes ──────────────────────────
        mist[20]: MistNode {
            parameters:
                nodeId           = index;
                idsEnabled       = parent.idsEnabled;
                adaptiveOffload  = parent.adaptiveOffload;
                attackRatio      = parent.attackRatio;
                useTrace         = parent.useTrace;
                // Each node gets its own trace slice (generated by train_models.py)
                traceFile        = "dataset/mist_node_" + string(index) + ".csv";
                generationInterval = 0.1s;   // 10 pkt/s per node
            @display("p=" + string(30 + index*42) + ",520,row;i=device/sensor;is=vs");
        }

        // ── Edge layer: 4 gateways (each serves 5 mist nodes) ────────
        edge[4]: EdgeGateway {
            parameters:
                gatewayId        = index;
                numMistNodes     = 5;
                idsEnabled       = parent.idsEnabled;
                detectionMode    = parent.detectionMode;
                latencyAwareRouting = parent.latencyAwareRouting;
            @display("p=" + string(90 + index*180) + ",360;i=device/router;is=s");
        }

        // ── Fog layer: 2 regional nodes (each serves 2 edge gateways) ─
        fog[2]: FogNode {
            parameters:
                fogId             = index;
                numEdgeGateways   = 2;
                idsEnabled        = parent.idsEnabled;
                enableDistillation = parent.enableDistillation;
            @display("p=" + string(225 + index*360) + ",200;i=device/server_l;is=s");
        }

        // ── Cloud layer: single global server ─────────────────────────
        cloud: CloudServer {
            parameters:
                serverId    = 0;
                numFogNodes = 2;
                idsEnabled  = parent.idsEnabled;
            @display("p=420,60;i=device/mainframe;is=l");
        }

    connections allowunconnected:
        // ── Mist → Edge (5 nodes per gateway) ────────────────────────
        // Gateway 0: mist[0..4]
        mist[0].out  --> MistToEdgeChan --> edge[0].mistIn[0];
        mist[1].out  --> MistToEdgeChan --> edge[0].mistIn[1];
        mist[2].out  --> MistToEdgeChan --> edge[0].mistIn[2];
        mist[3].out  --> MistToEdgeChan --> edge[0].mistIn[3];
        mist[4].out  --> MistToEdgeChan --> edge[0].mistIn[4];
        // Gateway 1: mist[5..9]
        mist[5].out  --> MistToEdgeChan --> edge[1].mistIn[0];
        mist[6].out  --> MistToEdgeChan --> edge[1].mistIn[1];
        mist[7].out  --> MistToEdgeChan --> edge[1].mistIn[2];
        mist[8].out  --> MistToEdgeChan --> edge[1].mistIn[3];
        mist[9].out  --> MistToEdgeChan --> edge[1].mistIn[4];
        // Gateway 2: mist[10..14]
        mist[10].out --> MistToEdgeChan --> edge[2].mistIn[0];
        mist[11].out --> MistToEdgeChan --> edge[2].mistIn[1];
        mist[12].out --> MistToEdgeChan --> edge[2].mistIn[2];
        mist[13].out --> MistToEdgeChan --> edge[2].mistIn[3];
        mist[14].out --> MistToEdgeChan --> edge[2].mistIn[4];
        // Gateway 3: mist[15..19]
        mist[15].out --> MistToEdgeChan --> edge[3].mistIn[0];
        mist[16].out --> MistToEdgeChan --> edge[3].mistIn[1];
        mist[17].out --> MistToEdgeChan --> edge[3].mistIn[2];
        mist[18].out --> MistToEdgeChan --> edge[3].mistIn[3];
        mist[19].out --> MistToEdgeChan --> edge[3].mistIn[4];

        // ── PolicyUpdate: Edge → Mist (reverse path) ──────────────────
        edge[0].mistOut[0] --> MistToEdgeChan --> mist[0].in;
        edge[0].mistOut[1] --> MistToEdgeChan --> mist[1].in;
        edge[0].mistOut[2] --> MistToEdgeChan --> mist[2].in;
        edge[0].mistOut[3] --> MistToEdgeChan --> mist[3].in;
        edge[0].mistOut[4] --> MistToEdgeChan --> mist[4].in;
        edge[1].mistOut[0] --> MistToEdgeChan --> mist[5].in;
        edge[1].mistOut[1] --> MistToEdgeChan --> mist[6].in;
        edge[1].mistOut[2] --> MistToEdgeChan --> mist[7].in;
        edge[1].mistOut[3] --> MistToEdgeChan --> mist[8].in;
        edge[1].mistOut[4] --> MistToEdgeChan --> mist[9].in;
        edge[2].mistOut[0] --> MistToEdgeChan --> mist[10].in;
        edge[2].mistOut[1] --> MistToEdgeChan --> mist[11].in;
        edge[2].mistOut[2] --> MistToEdgeChan --> mist[12].in;
        edge[2].mistOut[3] --> MistToEdgeChan --> mist[13].in;
        edge[2].mistOut[4] --> MistToEdgeChan --> mist[14].in;
        edge[3].mistOut[0] --> MistToEdgeChan --> mist[15].in;
        edge[3].mistOut[1] --> MistToEdgeChan --> mist[16].in;
        edge[3].mistOut[2] --> MistToEdgeChan --> mist[17].in;
        edge[3].mistOut[3] --> MistToEdgeChan --> mist[18].in;
        edge[3].mistOut[4] --> MistToEdgeChan --> mist[19].in;

        // ── Edge → Fog (2 gateways per fog node) ─────────────────────
        edge[0].fogOut --> EdgeToFogChan --> fog[0].edgeIn[0];
        edge[1].fogOut --> EdgeToFogChan --> fog[0].edgeIn[1];
        edge[2].fogOut --> EdgeToFogChan --> fog[1].edgeIn[0];
        edge[3].fogOut --> EdgeToFogChan --> fog[1].edgeIn[1];

        // ── PolicyUpdate: Fog → Edge ──────────────────────────────────
        fog[0].edgeOut[0] --> EdgeToFogChan --> edge[0].fogIn;
        fog[0].edgeOut[1] --> EdgeToFogChan --> edge[1].fogIn;
        fog[1].edgeOut[0] --> EdgeToFogChan --> edge[2].fogIn;
        fog[1].edgeOut[1] --> EdgeToFogChan --> edge[3].fogIn;

        // ── Fog → Cloud ───────────────────────────────────────────────
        fog[0].cloudOut --> FogToCloudChan --> cloud.fogIn[0];
        fog[1].cloudOut --> FogToCloudChan --> cloud.fogIn[1];

        // ── PolicyUpdate: Cloud → Fog ─────────────────────────────────
        cloud.fogOut[0] --> FogToCloudChan --> fog[0].cloudIn;
        cloud.fogOut[1] --> FogToCloudChan --> fog[1].cloudIn;
}
